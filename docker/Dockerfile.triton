# syntax=docker/dockerfile:1
# =============================================================================
# k3-sm80 kernel-kit — triton 티어 (PLAN.md §S2 전달 모델)
#
# 목적: k01~k04·k06·k07 실행 환경 = torch + triton + numpy 만.
#   커널 소스는 kernel-kit/vendor/ 에 vendor화되어 있어 vLLM 설치가 필요 없다.
#   k05(Marlin, vLLM C-확장)는 이 이미지로 실행 불가 → Dockerfile.full 사용.
#
# repo 는 이미지에 굽지 않는다 — /work 볼륨 마운트 방식(코드 갱신에 재빌드 불필요):
#   docker run --rm --gpus all -v <repo>:/work <img> bash /work/kernel-kit/run_all.sh
#
# 베이스 실존 근거 (2026-07-29 Docker Hub tags API + docker manifest inspect 확인):
#   pytorch/pytorch:2.13.0-cuda12.6-cudnn9-runtime  — 3.61 GiB compressed, pushed 2026-07-08
#   (2.13.0 태그는 cuda12.6 / cuda13.0 / cuda13.2 의 devel·runtime 6종만 존재.
#    CUDA 12.x runtime 요건 → cuda12.6 선택: full 티어(CUDA 13.0, driver r580+)와 달리
#    구형 드라이버(r560+/minor-compat)에서도 동작하는 보험 티어 역할.
#    torch 2.13.0 은 PyPI 메타데이터상 triton==3.7.1 을 linux 필수 의존으로 동반 → triton 동봉.)
ARG BASE_IMAGE=pytorch/pytorch:2.13.0-cuda12.6-cudnn9-runtime
FROM ${BASE_IMAGE}

ARG BASE_IMAGE
LABEL org.opencontainers.image.source="https://github.com/jimmylegendary/k3-sm80" \
      org.opencontainers.image.description="k3-sm80 S2 kernel-kit triton tier: torch 2.13.0 + triton (vendored KDA/conv/MLA kernels run WITHOUT vLLM; k01-k04,k06,k07)" \
      org.opencontainers.image.base.name="${BASE_IMAGE}"

ENV DEBIAN_FRONTEND=noninteractive \
    # 마운트된 /work(호스트 repo)에 root 소유 __pycache__ 를 남기지 않는다
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# git: run_all/env_check 가 리포트에 repo commit 을 기록(provenance)할 때 사용(없어도 동작은 함)
RUN apt-get update && apt-get install -y --no-install-recommends \
        git ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# 빌드 게이트: 이 티어의 계약(torch==2.13.0 / CUDA 12.x / triton / numpy)을 이미지 안에서 고정 검증.
# GPU 불필요 — import 와 버전 검사만 한다.
RUN python3 - <<'EOF'
import numpy, torch, triton
assert torch.__version__.startswith("2.13.0"), f"torch {torch.__version__} != 2.13.0"
assert (torch.version.cuda or "").startswith("12."), f"torch cuda {torch.version.cuda} != 12.x"
print("gate ok:", "torch", torch.__version__, "| cuda", torch.version.cuda,
      "| triton", triton.__version__, "| numpy", numpy.__version__)
EOF

# 계약 게이트(역방향): 이 이미지에 vllm 이 있으면 안 된다 (PLAN §S2 "vllm import 0건").
RUN if python3 -c "import vllm" 2>/dev/null; then \
        echo "FAIL: triton 티어에 vllm 존재 — 계약 위반" >&2; exit 1; fi

WORKDIR /work
CMD ["bash"]
