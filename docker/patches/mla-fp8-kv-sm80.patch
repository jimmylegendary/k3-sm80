diff --git a/vllm/models/kimi_k3/nvidia/ops/sm80_fp8_kv.py b/vllm/models/kimi_k3/nvidia/ops/sm80_fp8_kv.py
new file mode 100644
index 0000000..9c70911
--- /dev/null
+++ b/vllm/models/kimi_k3/nvidia/ops/sm80_fp8_kv.py
@@ -0,0 +1,242 @@
+# SPDX-License-Identifier: Apache-2.0
+"""Kimi-K3 SM80 software E4M3FN cache conversion.
+
+Storage is one uint8 E4M3FN code per latent element.  All attention queries,
+dot products, accumulation, and outputs remain BF16/FP32.  In particular this
+module never asks Triton or CUDA to materialize a native FP8 tensor.
+"""
+
+import torch
+
+from vllm.triton_utils import tl, triton
+
+
+PATCH_ID = "mla-fp8-kv-sm80-v1"
+CONVERSION_CONTRACT = "uint8/e4m3fn -> software decode -> bfloat16"
+# Machine-readable startup/verification token.
+native_fp8_arithmetic = False
+
+
+@triton.jit
+def _round_positive_rne(value):
+    lower = tl.floor(value)
+    fraction = value - lower
+    lower_i = lower.to(tl.int32)
+    round_up = (fraction > 0.5) | (
+        (fraction == 0.5) & ((lower_i & 1) != 0)
+    )
+    return lower_i + round_up.to(tl.int32)
+
+
+@triton.jit
+def e4m3_bits_to_fp32(bits):
+    bits_i = bits.to(tl.int32)
+    sign = (bits_i >> 7) & 1
+    exponent = (bits_i >> 3) & 0xF
+    mantissa = bits_i & 0x7
+    subnormal = mantissa.to(tl.float32) * (2.0**-9)
+    normal = (1.0 + mantissa.to(tl.float32) / 8.0) * tl.exp2(
+        exponent.to(tl.float32) - 7.0
+    )
+    value = tl.where(exponent == 0, subnormal, normal)
+    value = tl.where(sign == 0, value, -value)
+    return tl.where(
+        (exponent == 0xF) & (mantissa == 0x7), float("nan"), value
+    )
+
+
+@triton.jit
+def _fp32_to_e4m3_bits(value):
+    is_nan = value != value
+    is_negative = (value < 0.0) | (
+        (value == 0.0) & ((1.0 / value) < 0.0)
+    )
+    magnitude = tl.abs(value)
+    sub_q = _round_positive_rne(magnitude * 512.0)
+    safe_magnitude = tl.maximum(magnitude, 2.0**-6)
+    exponent = tl.floor(tl.log2(safe_magnitude)).to(tl.int32)
+    exponent = tl.maximum(-6, tl.minimum(8, exponent))
+    step = tl.exp2(exponent.to(tl.float32) - 3.0)
+    normal_q = _round_positive_rne(magnitude / step)
+    carry = normal_q >= 16
+    exponent += carry.to(tl.int32)
+    normal_q = tl.where(carry, 8, normal_q)
+    normal_code = ((exponent + 7) << 3) + (normal_q - 8)
+    positive = tl.where(magnitude < 2.0**-6, sub_q, normal_code)
+    positive = tl.minimum(positive, 0x7E)
+    positive = tl.where(magnitude >= 448.0, 0x7E, positive)
+    signed = positive | (is_negative.to(tl.int32) << 7)
+    return tl.where(is_nan, 0x7F, signed)
+
+
+@triton.jit
+def _software_fp8_cache_insert_kernel(
+    kv_c,
+    k_pe,
+    cache,
+    slot_mapping,
+    cache_scale_inv,
+    n_tokens,
+    cache_block_stride,
+    cache_token_stride,
+    kv_lora_rank: tl.constexpr,
+    rope_dim: tl.constexpr,
+    cache_block_size: tl.constexpr,
+    block_size: tl.constexpr,
+):
+    entry_size: tl.constexpr = kv_lora_rank + rope_dim
+    offsets = tl.program_id(0) * block_size + tl.arange(0, block_size)
+    total = n_tokens * entry_size
+    in_range = offsets < total
+    token = offsets // entry_size
+    channel = offsets - token * entry_size
+    safe_token = tl.where(token < n_tokens, token, 0)
+    slot = tl.load(slot_mapping + safe_token, mask=in_range, other=-1)
+    valid = in_range & (slot >= 0)
+    kv_offset = safe_token * kv_lora_rank + channel
+    pe_offset = safe_token * rope_dim + (channel - kv_lora_rank)
+    value = tl.where(
+        channel < kv_lora_rank,
+        tl.load(kv_c + kv_offset, mask=valid & (channel < kv_lora_rank), other=0.0),
+        tl.load(k_pe + pe_offset, mask=valid & (channel >= kv_lora_rank), other=0.0),
+    ).to(tl.float32)
+    scale_inv = tl.load(cache_scale_inv)
+    bits = _fp32_to_e4m3_bits(value * scale_inv)
+    cache_block = slot // cache_block_size
+    cache_token = slot - cache_block * cache_block_size
+    cache_offset = (
+        cache_block * cache_block_stride
+        + cache_token * cache_token_stride
+        + channel
+    )
+    tl.store(cache + cache_offset, bits.to(tl.uint8), mask=valid)
+
+
+def software_fp8_cache_insert(
+    kv_c_normed: torch.Tensor,
+    k_pe: torch.Tensor,
+    cache: torch.Tensor,
+    slot_mapping: torch.Tensor,
+    cache_scale_inv: torch.Tensor,
+) -> None:
+    """Insert K3 latent rows into a uint8 paged cache using software RNE."""
+    if cache.dtype != torch.uint8:
+        raise TypeError(f"software FP8 cache must be uint8, got {cache.dtype}")
+    if kv_c_normed.dtype not in (torch.bfloat16, torch.float16):
+        raise TypeError(f"software FP8 source must be BF16/FP16, got {kv_c_normed.dtype}")
+    if not (kv_c_normed.is_cuda and k_pe.is_cuda and cache.is_cuda):
+        raise ValueError("software FP8 cache conversion requires CUDA tensors")
+    k_pe = k_pe.reshape(k_pe.shape[0], -1).contiguous()
+    kv_c_normed = kv_c_normed.contiguous()
+    n_tokens, kv_lora_rank = kv_c_normed.shape
+    rope_dim = k_pe.shape[1]
+    if cache.shape[-1] != kv_lora_rank + rope_dim:
+        raise ValueError(
+            f"cache entry {cache.shape[-1]} != {kv_lora_rank}+{rope_dim}"
+        )
+    total = n_tokens * (kv_lora_rank + rope_dim)
+    launch_block = 256
+    _software_fp8_cache_insert_kernel[(triton.cdiv(total, launch_block),)](
+        kv_c_normed,
+        k_pe,
+        cache,
+        slot_mapping,
+        cache_scale_inv,
+        n_tokens=n_tokens,
+        cache_block_stride=cache.stride(0),
+        cache_token_stride=cache.stride(1),
+        kv_lora_rank=kv_lora_rank,
+        rope_dim=rope_dim,
+        cache_block_size=cache.shape[1],
+        block_size=launch_block,
+        num_warps=4,
+    )
+
+
+@triton.jit
+def _software_gather_fp8_cache_kernel(
+    src_cache,
+    dst,
+    block_table,
+    cu_seq_lens,
+    token_to_seq,
+    seq_starts,
+    scale,
+    num_tokens,
+    cache_block_size: tl.constexpr,
+    entry_size: tl.constexpr,
+    block_table_stride: tl.constexpr,
+    cache_block_stride: tl.constexpr,
+    cache_token_stride: tl.constexpr,
+    has_seq_starts: tl.constexpr,
+    launch_block: tl.constexpr,
+):
+    offsets = tl.program_id(0) * launch_block + tl.arange(0, launch_block)
+    total = num_tokens * entry_size
+    in_range = offsets < total
+    token = offsets // entry_size
+    channel = offsets - token * entry_size
+    safe_token = tl.where(token < num_tokens, token, 0)
+    sequence = tl.load(token_to_seq + safe_token, mask=in_range, other=0)
+    sequence_start = tl.load(cu_seq_lens + sequence, mask=in_range, other=0)
+    sequence_offset = safe_token - sequence_start
+    if has_seq_starts:
+        sequence_offset += tl.load(
+            seq_starts + sequence, mask=in_range, other=0
+        )
+    logical_page = sequence_offset // cache_block_size
+    page_offset = sequence_offset - logical_page * cache_block_size
+    physical_page = tl.load(
+        block_table + sequence * block_table_stride + logical_page,
+        mask=in_range,
+        other=0,
+    )
+    physical_offset = (
+        physical_page * cache_block_stride
+        + page_offset * cache_token_stride
+        + channel
+    )
+    bits = tl.load(src_cache + physical_offset, mask=in_range, other=0).to(tl.uint8)
+    value = e4m3_bits_to_fp32(bits) * tl.load(scale)
+    tl.store(dst + offsets, value.to(tl.bfloat16), mask=in_range)
+
+
+def software_gather_fp8_cache(
+    *,
+    src_cache: torch.Tensor,
+    dst: torch.Tensor,
+    block_table: torch.Tensor,
+    cu_seq_lens: torch.Tensor,
+    token_to_seq: torch.Tensor,
+    num_tokens: int,
+    scale: torch.Tensor,
+    seq_starts: torch.Tensor | None = None,
+) -> None:
+    """Gather/dequant K3 context rows into the existing BF16 workspace."""
+    if src_cache.dtype != torch.uint8:
+        raise TypeError(f"software FP8 source cache must be uint8, got {src_cache.dtype}")
+    if dst.dtype != torch.bfloat16:
+        raise TypeError(f"software FP8 gather destination must be BF16, got {dst.dtype}")
+    if src_cache.shape[-1] != 576 or dst.shape[-1] != 576:
+        raise ValueError("Kimi-K3 software FP8 gather requires 576-element cache rows")
+    launch_block = 256
+    total = int(num_tokens) * 576
+    starts = seq_starts if seq_starts is not None else cu_seq_lens
+    _software_gather_fp8_cache_kernel[(triton.cdiv(total, launch_block),)](
+        src_cache,
+        dst,
+        block_table,
+        cu_seq_lens,
+        token_to_seq,
+        starts,
+        scale,
+        num_tokens=int(num_tokens),
+        cache_block_size=src_cache.shape[1],
+        entry_size=576,
+        block_table_stride=block_table.stride(0),
+        cache_block_stride=src_cache.stride(0),
+        cache_token_stride=src_cache.stride(1),
+        has_seq_starts=seq_starts is not None,
+        launch_block=launch_block,
+        num_warps=4,
+    )
