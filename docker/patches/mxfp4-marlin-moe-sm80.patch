+def assert_sm80_mxfp4_kernel_generated():
+    """Fail the build if the original-checkpoint MXFP4 MoE image is absent."""
+    if not SUPPORT_SM80:
+        return
+
+    # Kimi K3's fused_marlin_moe fallback on sm_80 is BF16 x
+    # MXFP4(kFE2M1f + kFE8M0fnu), not a W4A16 re-quantized checkpoint.
+    expected_name = "sm80_kernel_bfloat16_fe2m1f_bfloat16.cu"
+    expected_path = os.path.join(os.path.dirname(__file__), expected_name)
+    if not os.path.isfile(expected_path):
+        raise RuntimeError(
+            "sm_80 MXFP4 Marlin MoE kernel was not generated: "
+            f"{expected_name}"
+        )
+    generated = open(expected_path, encoding="utf-8").read()
+    for scalar_type in ("kFE2M1f", "kFE8M0fnu"):
+        if scalar_type not in generated:
+            raise RuntimeError(
+                f"sm_80 MXFP4 Marlin MoE kernel lacks {scalar_type}: "
+                f"{expected_name}"
+            )
+
+
 if __name__ == "__main__":
     remove_old_kernels()
     generate_new_kernels()
+    assert_sm80_mxfp4_kernel_generated()
