+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Kimi K3.1 DSA의 SM80(A100) glue 테스트.
+
+`use_sm80_dsa()`의 capability 자동 판정/환경변수 override와, Triton fp8e4nv 없이
+CUDA `per_token_group_quant_fp8`로 query를 양자화하는 `_sm80_q_quant_fold_weights`가
+`indexer_q_quant_fold_weights`와 같은 수식(ue8m0 scale, 접힌 fp32 weights)인지 본다.
+"""
+
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+from vllm.models.kimi_k3.nvidia.dsa import KimiK3DSAIndexer, use_sm80_dsa
+from vllm.platforms import current_platform
+
+HEAD_DIM = 128
+FP8_MAX = 448.0
+
+
+@pytest.fixture
+def fake_cuda(monkeypatch):
+    """GPU 없이 `use_sm80_dsa`의 capability 분기를 시험하는 플랫폼 스텁."""
+
+    def install(capability: int, *, cuda: bool = True) -> None:
+        monkeypatch.setattr(current_platform, "is_cuda", lambda: cuda)
+        monkeypatch.setattr(
+            current_platform,
+            "has_device_capability",
+            lambda required, device_id=0: capability >= required,
+        )
+
+    monkeypatch.delenv("VLLM_K31_SM80_DSA", raising=False)
+    return install
+
+
+@pytest.mark.parametrize(
+    "capability,expected",
+    [(75, True), (80, True), (86, True), (89, False), (90, False), (100, False)],
+)
+def test_auto_detection_follows_capability(fake_cuda, capability, expected):
+    fake_cuda(capability)
+    assert use_sm80_dsa() is expected
+
+
+def test_not_cuda_is_never_sm80(fake_cuda):
+    fake_cuda(80, cuda=False)
+    assert use_sm80_dsa() is False
+
+
+@pytest.mark.parametrize("capability", [80, 90])
+def test_env_forces_on_and_off(fake_cuda, monkeypatch, capability):
+    fake_cuda(capability)
+    monkeypatch.setenv("VLLM_K31_SM80_DSA", "1")
+    assert use_sm80_dsa() is True
+    monkeypatch.setenv("VLLM_K31_SM80_DSA", "0")
+    assert use_sm80_dsa() is False
+    # 알 수 없는 값은 미설정과 같다(자동 판정).
+    monkeypatch.setenv("VLLM_K31_SM80_DSA", "maybe")
+    assert use_sm80_dsa() is (capability < 89)
+
+
+def test_env_is_registered_with_vllm_envs(monkeypatch):
+    """미등록 VLLM_* 환경변수는 `validate_environ`이 경고/실패 처리한다."""
+    import vllm.envs as envs
+
+    assert "VLLM_K31_SM80_DSA" in envs.environment_variables
+    monkeypatch.delenv("VLLM_K31_SM80_DSA", raising=False)
+    assert envs.VLLM_K31_SM80_DSA is None
+    monkeypatch.setenv("VLLM_K31_SM80_DSA", "1")
+    assert envs.VLLM_K31_SM80_DSA is True
+
+
+@pytest.mark.skipif(not current_platform.is_cuda(), reason="CUDA quant op needed")
+@pytest.mark.parametrize("num_heads", [32, 20])
+@pytest.mark.parametrize("num_tokens", [1, 33, 300])
+@torch.inference_mode()
+def test_sm80_q_quant_fold_weights_matches_formula(num_heads, num_tokens):
+    torch.manual_seed(0)
+    padded = 32
+    q = torch.randn(
+        num_tokens, num_heads, HEAD_DIM, dtype=torch.bfloat16, device="cuda"
+    )
+    q[0, 0].zero_()  # 모든 원소가 0인 그룹: amax 하한(eps)을 밟는다.
+    kw = torch.randn(
+        num_tokens, HEAD_DIM + num_heads, dtype=torch.bfloat16, device="cuda"
+    )
+    w = kw[:, HEAD_DIM:]
+    weight_scale = HEAD_DIM**-0.5 * num_heads**-0.5
+
+    fake_self = SimpleNamespace(padded_index_num_heads=padded)
+    q_fp8, weights = KimiK3DSAIndexer._sm80_q_quant_fold_weights(
+        fake_self, q, w, weight_scale
+    )
+
+    # 독립 기준 수식 (indexer_q_quant_fold_weights의 Triton 커널과 같은 수식)
+    amax = q.float().abs().amax(dim=-1).clamp_min(1e-10)
+    scale = torch.exp2(torch.ceil(torch.log2((amax / FP8_MAX).clamp_min(1e-10))))
+    ref_fp8 = (
+        (q.float() / scale[..., None])
+        .clamp(-FP8_MAX, FP8_MAX)
+        .to(current_platform.fp8_dtype())
+    )
+    ref_weights = w.float() * scale * weight_scale
+
+    assert q_fp8.dtype == current_platform.fp8_dtype()
+    assert q_fp8.shape == (num_tokens, padded, HEAD_DIM)
+    assert weights.shape == (num_tokens, padded)
+    assert weights.dtype == torch.float32
+    assert torch.equal(
+        q_fp8[:, :num_heads].view(torch.uint8), ref_fp8.view(torch.uint8)
+    )
+    torch.testing.assert_close(weights[:, :num_heads], ref_weights)
+    if padded != num_heads:
+        assert torch.count_nonzero(q_fp8[:, num_heads:].view(torch.uint8)) == 0
+        assert torch.count_nonzero(weights[:, num_heads:]) == 0
+
+
+@pytest.mark.skipif(not current_platform.is_cuda(), reason="CUDA quant op needed")
+def test_sm80_q_quant_handles_empty_batch():
+    fake_self = SimpleNamespace(padded_index_num_heads=32)
+    q = torch.empty(0, 32, HEAD_DIM, dtype=torch.bfloat16, device="cuda")
+    w = torch.empty(0, 32, dtype=torch.bfloat16, device="cuda")
+    q_fp8, weights = KimiK3DSAIndexer._sm80_q_quant_fold_weights(fake_self, q, w, 0.5)
+    assert q_fp8.shape == (0, 32, HEAD_DIM)
+    assert weights.shape == (0, 32)
