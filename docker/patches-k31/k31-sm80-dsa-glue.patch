+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Kimi K3.1 DSA indexer 전체 경로의 SM80(A100) 검증.
+
+`KimiK3DSAIndexer.score`가 SM80 glue(`use_sm80_dsa`)로 도는 경로를 그대로 탄다:
+CUDA `per_token_group_quant_fp8` Q 양자화 -> `sparse_attn_indexer`가 stock CUDA
+`indexer_k_quant_and_cache`로 key 삽입 -> Triton MQA logits(DeepGEMM 없음) ->
+top-k. 결과 top-k를 fp8 캐시를 역양자화한 fp32 기준 구현과 비교한다.
+SM90/SM100(DeepGEMM 지원)에서는 Triton 분기를 타지 않으므로 건너뛴다.
+
+실행(vLLM 테스트 의존성 없이): `python -m pytest --noconftest -p no:cacheprovider \
+tests/models/kimi_k3/test_dsa_sm80_indexer.py`.
+"""
+
+import functools
+from types import SimpleNamespace
+
+import pytest
+import torch
+
+import vllm.model_executor.layers.sparse_attn_indexer as sparse_indexer
+from vllm import _custom_ops as ops
+from vllm.config import CUDAGraphMode
+from vllm.models.kimi_k3.nvidia.dsa import KimiK3DSAIndexer
+from vllm.platforms import current_platform
+from vllm.utils.deep_gemm import is_deep_gemm_supported
+from vllm.v1.attention.backends.mla.indexer import (
+    DeepSeekV32IndexerDecodeMetadata,
+    DeepseekV32IndexerMetadata,
+    DeepseekV32IndexerPrefillChunkMetadata,
+    DeepseekV32IndexerPrefillMetadata,
+)
+
+pytestmark = pytest.mark.skipif(
+    not current_platform.is_cuda() or is_deep_gemm_supported(),
+    reason="SM80 Triton indexer fallback (CUDA without DeepGEMM)",
+)
+
+HEAD_DIM = 128
+NUM_HEADS = 32
+ENTRY = HEAD_DIM + 4  # fp8 값 + token당 fp32 scale 1개
+BLOCK = 64
+TOPK = 2048
+# packed hybrid KV row 안의 한 layer 페이지처럼 block stride를 크게 둔다:
+# block >= 1024에서 `block * stride`가 2**31 바이트를 넘는다.
+ROW_STRIDE = 2**21
+PREFIX = "model.layers.3.self_attn.indexer.k_cache"
+
+
+@pytest.fixture
+def workspace_init():
+    """루트 conftest 없이(`--noconftest`)도 도는 workspace manager 초기화."""
+    from vllm.v1.worker.workspace import (
+        init_workspace_manager,
+        reset_workspace_manager,
+    )
+
+    init_workspace_manager(torch.device("cuda"))
+    yield
+    reset_workspace_manager()
+
+
+def _make_cache(num_blocks: int, strided: bool) -> torch.Tensor:
+    """Indexer 캐시 view `[num_blocks, BLOCK, ENTRY]` (uint8)."""
+    if not strided:
+        return torch.zeros(num_blocks, BLOCK, ENTRY, dtype=torch.uint8, device="cuda")
+    raw = torch.zeros(num_blocks * ROW_STRIDE, dtype=torch.uint8, device="cuda")
+    return torch.as_strided(
+        raw, size=(num_blocks, BLOCK, ENTRY), stride=(ROW_STRIDE, ENTRY, 1)
+    )
+
+
+def _dequant(view: torch.Tensor) -> torch.Tensor:
+    """캐시 전체를 `[num_blocks * BLOCK, HEAD_DIM]` fp32로 역양자화한다."""
+    rows = []
+    for b in range(view.shape[0]):
+        flat = view[b].reshape(-1)
+        data = flat[: BLOCK * HEAD_DIM].view(current_platform.fp8_dtype())
+        data = data.view(BLOCK, HEAD_DIM).float()
+        scale = flat[BLOCK * HEAD_DIM : BLOCK * ENTRY].contiguous().view(torch.float32)
+        rows.append(data * scale[:, None])
+    return torch.cat(rows)
+
+
+def _make_indexer(cache, topk_buffer, max_model_len) -> SimpleNamespace:
+    indexer = SimpleNamespace(
+        use_fp4_cache=False,
+        use_sm80_dsa=True,
+        index_softmax_scale=HEAD_DIM**-0.5,
+        indexer_weight_scale=NUM_HEADS**-0.5,
+        padded_index_num_heads=NUM_HEADS,
+        k_cache=SimpleNamespace(prefix=PREFIX, kv_cache=cache),
+        quant_block_size=HEAD_DIM,
+        scale_fmt="ue8m0",
+        topk_tokens=TOPK,
+        index_head_dim=HEAD_DIM,
+        max_model_len=max_model_len,
+        max_total_seq_len=max_model_len,
+        topk_indices_buffer=topk_buffer,
+        use_fused_k_insert=False,
+        use_pcp=False,
+        _parallel_config=SimpleNamespace(pcp_shard_decode_requests=False),
+        dense_mha_metadata_layer_name="",
+        dcp_rank=0,
+        dcp_world_size=1,
+        cp_kv_cache_interleave_size=1,
+        topk_backend="auto",
+    )
+    indexer._sm80_q_quant_fold_weights = functools.partial(
+        KimiK3DSAIndexer._sm80_q_quant_fold_weights, indexer
+    )
+    return indexer
+
+
+def _logits_ref(q_deq: torch.Tensor, w: torch.Tensor, k_deq: torch.Tensor):
+    """sum_h relu(q_h . k) * w_h  for every (row, key)."""
+    return (torch.einsum("thd,nd->thn", q_deq, k_deq).relu() * w[..., None]).sum(1)
+
+
+def _quantized_q(indexer, q, w):
+    """score()가 쓰는 Q 양자화를 그대로 적용해 기준 구현의 입력을 만든다."""
+    weight_scale = indexer.index_softmax_scale * indexer.indexer_weight_scale
+    q_fp8, weights = indexer._sm80_q_quant_fold_weights(q, w, weight_scale)
+    return q_fp8.float(), weights
+
+
+@pytest.mark.parametrize("strided", [False, True], ids=["contiguous", "big-stride"])
+@torch.inference_mode()
+def test_decode_topk_matches_reference(
+    monkeypatch: pytest.MonkeyPatch, workspace_init, strided: bool
+):
+    """decode: 요청당 query 1개가 자기 컨텍스트에서 고른 top-k가 기준과 같다."""
+    torch.manual_seed(0)
+    seq_lens = torch.tensor([1000, 3000, 6100, 4500], device="cuda").int()
+    batch = seq_lens.shape[0]
+    max_blocks = (int(seq_lens.max()) + BLOCK - 1) // BLOCK
+    # big-stride: block id가 1024를 넘어야 int32 오프셋이 wrap하는 구간을 밟는다.
+    num_blocks = 1100 if strided else batch * max_blocks + 1
+    perm = torch.randperm(num_blocks, device="cuda").int()
+    block_table = perm[: batch * max_blocks].view(batch, max_blocks).contiguous()
+    req = torch.repeat_interleave(torch.arange(batch, device="cuda"), seq_lens.long())
+    pos = torch.cat([torch.arange(n, device="cuda") for n in seq_lens.tolist()])
+    slots = block_table[req, pos // BLOCK].long() * BLOCK + pos % BLOCK
+
+    cache = _make_cache(num_blocks, strided)
+    k_all = torch.randn(slots.shape[0], HEAD_DIM, dtype=torch.bfloat16, device="cuda")
+    # 이전 step들이 이미 쌓은 캐시: stock CUDA op (use_fused_k_insert=False 경로).
+    ops.indexer_k_quant_and_cache(k_all, cache, slots, HEAD_DIM, "ue8m0")
+
+    topk = torch.full((batch, TOPK), -1, dtype=torch.int32, device="cuda")
+    indexer = _make_indexer(cache, topk, max_blocks * BLOCK)
+    context_lens = seq_lens.view(-1, 1).contiguous()
+    last = torch.cumsum(seq_lens.long(), 0) - 1  # 각 요청의 마지막 토큰 = decode 토큰
+    metadata = DeepseekV32IndexerMetadata(
+        seq_lens=seq_lens,
+        max_seq_len=int(seq_lens.max()),
+        slot_mapping=slots[last].contiguous(),
+        num_decodes=batch,
+        num_decode_tokens=batch,
+        num_prefills=0,
+        num_prefill_tokens=0,
+        decode=DeepSeekV32IndexerDecodeMetadata(
+            block_table=block_table,
+            seq_lens=context_lens,
+            decode_lens=torch.ones(batch, dtype=torch.int32, device="cuda"),
+            requires_padding=False,
+            schedule_metadata=torch.zeros(1, 2, dtype=torch.int32, device="cuda"),
+        ),
+    )
+    monkeypatch.setattr(
+        sparse_indexer,
+        "get_forward_context",
+        lambda: SimpleNamespace(
+            attn_metadata={PREFIX: metadata},
+            cudagraph_runtime_mode=CUDAGraphMode.NONE,
+        ),
+    )
+    q = torch.randn(batch, NUM_HEADS, HEAD_DIM, dtype=torch.bfloat16, device="cuda")
+    w = torch.randn(batch, NUM_HEADS, dtype=torch.bfloat16, device="cuda")
+    hidden_states = torch.empty(batch, 16, dtype=torch.bfloat16, device="cuda")
+    # score()는 decode 토큰의 key를 op 안에서 다시 삽입한다(같은 값, 멱등).
+    KimiK3DSAIndexer.score(indexer, hidden_states, q, w, k_all[last])
+
+    q_deq, weights = _quantized_q(indexer, q, w)
+    k_deq = _dequant(cache)
+    for b, n in enumerate(seq_lens.tolist()):
+        keys = k_deq[slots[req == b]]
+        ref = _logits_ref(q_deq[b : b + 1], weights[b : b + 1], keys)[0]
+        got = topk[b][topk[b] >= 0]
+        assert got.numel() == min(n, TOPK) and int(got.max()) < n, b
+        if n <= TOPK:
+            assert torch.equal(got.sort().values, torch.arange(n, device="cuda"))
+            continue
+        # bf16 곱 + fp32 누적(Triton) vs fp32 기준: 컷 경계의 near-tie만 다를 수 있다.
+        recall = torch.isin(got, ref.topk(TOPK).indices).float().mean().item()
+        assert recall > 0.99, (b, recall)
+
+
+@torch.inference_mode()
+def test_prefill_topk_matches_reference(
+    monkeypatch: pytest.MonkeyPatch, workspace_init
+):
+    """prefill: 한 요청의 모든 토큰이 causal 구간에서 고른 top-k가 기준과 같다."""
+    torch.manual_seed(1)
+    length = 2600  # index_topk(2048)를 넘는 행이 실제 선택을 한다.
+    max_blocks = (length + BLOCK - 1) // BLOCK
+    num_blocks = max_blocks + 3
+    block_table = (
+        torch.randperm(num_blocks, device="cuda")[:max_blocks]
+        .int()
+        .view(1, max_blocks)
+        .contiguous()
+    )
+    pos = torch.arange(length, device="cuda")
+    slots = block_table[0, pos // BLOCK].long() * BLOCK + pos % BLOCK
+
+    cache = _make_cache(num_blocks, strided=False)
+    k = torch.randn(length, HEAD_DIM, dtype=torch.bfloat16, device="cuda")
+    topk = torch.full((length, TOPK), 7, dtype=torch.int32, device="cuda")
+    indexer = _make_indexer(cache, topk, max_blocks * BLOCK)
+    cu_seq_lens = torch.tensor([0, length], dtype=torch.int32, device="cuda")
+    chunk = DeepseekV32IndexerPrefillChunkMetadata(
+        block_table=block_table,
+        cu_seqlen_ks=torch.zeros(length, dtype=torch.int32, device="cuda"),
+        cu_seqlen_ke=torch.arange(1, length + 1, dtype=torch.int32, device="cuda"),
+        cu_seq_lens=cu_seq_lens,
+        token_to_seq=torch.zeros(length, dtype=torch.int32, device="cuda"),
+        total_seq_lens=length,
+        max_seqlen_k=length,
+        token_start=0,
+        token_end=length,
+        num_reqs=1,
+        local_cu_seq_lens=cu_seq_lens,
+        local_total_seq_lens=length,
+        max_local_total_seq_lens=length,
+    )
+    metadata = DeepseekV32IndexerMetadata(
+        seq_lens=torch.tensor([length], dtype=torch.int32, device="cuda"),
+        max_seq_len=length,
+        slot_mapping=slots.contiguous(),
+        num_decodes=0,
+        num_decode_tokens=0,
+        num_prefills=1,
+        num_prefill_tokens=length,
+        prefill=DeepseekV32IndexerPrefillMetadata(chunks=[chunk]),
+    )
+    monkeypatch.setattr(
+        sparse_indexer,
+        "get_forward_context",
+        lambda: SimpleNamespace(
+            attn_metadata={PREFIX: metadata},
+            cudagraph_runtime_mode=CUDAGraphMode.NONE,
+        ),
+    )
+    q = torch.randn(length, NUM_HEADS, HEAD_DIM, dtype=torch.bfloat16, device="cuda")
+    w = torch.randn(length, NUM_HEADS, dtype=torch.bfloat16, device="cuda")
+    hidden_states = torch.empty(length, 16, dtype=torch.bfloat16, device="cuda")
+    KimiK3DSAIndexer.score(indexer, hidden_states, q, w, k)
+
+    q_deq, weights = _quantized_q(indexer, q, w)
+    k_deq = _dequant(cache)[slots]  # 토큰 순서의 역양자화된 key
+    for row in (0, 1, 100, 2046, 2047, 2048, 2300, length - 1):
+        n = row + 1  # row i는 key [0, i]를 본다.
+        ref = _logits_ref(q_deq[row : row + 1], weights[row : row + 1], k_deq[:n])[0]
+        got = topk[row][topk[row] >= 0]
+        assert got.numel() == min(n, TOPK) and int(got.max()) < n, row
+        if n <= TOPK:
+            assert torch.equal(got.sort().values, torch.arange(n, device="cuda"))
+            continue
+        recall = torch.isin(got, ref.topk(TOPK).indices).float().mean().item()
+        assert recall > 0.99, (row, recall)
