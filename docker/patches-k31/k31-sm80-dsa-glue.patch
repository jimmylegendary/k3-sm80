+    def _sm80_q_quant_fold_weights(
+        self,
+        index_q: torch.Tensor,
+        index_weights: torch.Tensor,
+        weight_scale: float,
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        """`indexer_q_quant_fold_weights`의 SM80 대체 (Triton fp8e4nv 없이).
+
+        같은 수식을 CUDA op로 계산한다: query `[T, H, D]`를 head별 ue8m0 scale
+        (eps 1e-10, `scale_fmt`와 같은 power-of-2)로 fp8(e4m3) 양자화하고, 각 head의
+        scale을 `index_weights`와 `weight_scale`에 접어 fp32 weights로 돌려준다.
+        Q를 bf16 그대로 두지 않고 fp8로 양자화하는 이유: `sparse_attn_indexer`의
+        계약(fp8 q_quant + 접힌 weights)과 K 캐시(fp8)를 DeepGEMM 경로와 똑같이
+        두어 top-k 경계가 SM90/SM100과 같은 양자화 오차를 갖게 하기 위함이다.
+        `-> (q_fp8 [T, P, D], weights [T, P] fp32)`, P = padded_index_num_heads;
+        head `[H, P)`는 0.
+        """
+        num_tokens, num_heads, head_dim = index_q.shape
+        padded = self.padded_index_num_heads
+        fp8_dtype = current_platform.fp8_dtype()
+        if num_tokens == 0:
+            return (
+                torch.empty(
+                    (0, padded, head_dim), dtype=fp8_dtype, device=index_q.device
+                ),
+                torch.empty((0, padded), dtype=torch.float32, device=index_q.device),
+            )
+        # 한 (token, head) 행이 한 양자화 그룹이다. 비연속 입력은 Triton 폴백(fp8e4nv)
+        # 으로 빠지므로 contiguous를 보장한다.
+        q_fp8, q_scale = per_token_group_quant_fp8(
+            index_q.reshape(-1, head_dim).contiguous(), head_dim, use_ue8m0=True
+        )
+        folded = (
+            index_weights.float() * q_scale.view(num_tokens, num_heads) * weight_scale
+        )
+        q_fp8 = q_fp8.view(num_tokens, num_heads, head_dim)
+        if padded == num_heads:
+            return q_fp8, folded
+        q_padded = q_fp8.new_zeros((num_tokens, padded, head_dim))
+        q_padded[:, :num_heads] = q_fp8
+        weights = folded.new_zeros((num_tokens, padded))
+        weights[:, :num_heads] = folded
+        return q_padded, weights
