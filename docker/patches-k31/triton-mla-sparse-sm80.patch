+        assert not TritonMLASparseBackend.supports_kv_cache_dtype(kv)
+
+
+def test_validate_configuration_accepts_the_k31_sm80_lane():
+    assert _validate(SM80) == []
+    assert _validate(SM86) == []
+    assert _validate(SM80, kv_cache_dtype="auto") == []
+
+
+def test_validate_configuration_rejects_unsupported_combinations():
+    assert "compute capability not supported" in _validate(SM90)
+    # fp8_ds_mla(K3.1이 `auto`/`fp8*`를 재작성하는 형식)는 안내 문구와 함께 거부된다.
+    reasons = _validate(SM80, kv_cache_dtype="fp8_ds_mla")
