+
+
+@pytest.mark.parametrize("num_heads", [12, 16, 24, 48, 96, 128])
+@pytest.mark.parametrize("sm_count", [84, 108, 132])
+def test_workspace_bound_covers_every_split_the_kernel_can_request(num_heads, sm_count):
+    """예약한 스크래치 상한이 `triton_mla_sparse_attention`의 실제 요청을 덮는다.
+
+    workspace가 잠긴 뒤 증설은 AssertionError라, 상한이 한 토큰 수라도 모자라면
+    첫 decode에서 죽는다. 토큰 수 sm_count 이상은 single-pass(스크래치 없음)다.
+    """
+    index_topk = 2048
+    bound = max_split_mid_out_numel(num_heads, index_topk, sm_count)
+    num_head_groups = -(-num_heads // min(_BLOCK_H, num_heads))
+    biggest = 0
+    for num_tokens in range(1, 4 * sm_count):
+        splits = _choose_num_kv_splits(
+            num_tokens, num_head_groups, index_topk, sm_count
+        )
+        if splits > 1:
+            needed = num_tokens * num_heads * splits * (_BLOCK_DV + 1)
+            assert needed <= bound, (num_tokens, splits)
+            biggest = max(biggest, needed)
+        else:
+            assert num_tokens * num_head_groups * 4 >= sm_count or num_tokens == 0
+    assert bound == biggest
+    # 12 head/108 SM: 소량의 토큰만 split한다(수 MB 규모).
+    if (num_heads, sm_count) == (12, 108):
+        assert 0 < bound * 4 < 64 * 2**20
+
+
+@pytest.mark.skipif(not current_platform.is_cuda(), reason="Triton kernel needs CUDA")
+@pytest.mark.parametrize(
+    "block_stride_rows",
+    [64, 1712],  # 1712 = 64 x 26.75: K3.1 packed hybrid KV row (block stride > block)
+    ids=["dense-blocks", "packed-row"],
+)
+@pytest.mark.parametrize("use_workspace", [False, True], ids=["alloc", "workspace"])
+@torch.inference_mode()
+def test_forward_mqa_kernel_reads_packed_kv_rows(
+    request, block_stride_rows, use_workspace
+):
+    """`_forward_mqa_kernel`: (ql_nope, q_pe) concat + `flat_kv_row_view` + 커널.
+
+    packed layout의 layer 캐시는 block 사이에 다른 layer의 page가 있어
+    `stride(0) > block_size * 576`이다. 물리 row id = block * block_stride_rows +
+    offset 로 top-k를 주면 기준(dense gather) 결과와 같아야 한다. `workspace`
+    변형은 workspace를 잠근 뒤(lock) 예약분 안에서 split-KV 스크래치를 받는다.
+    """
+    if use_workspace:
+        request.getfixturevalue("workspace_init")
+    torch.manual_seed(0)
+    block_size, num_heads, topk, sm_count = 64, 12, 2048, 108
+    num_blocks = 40
+    storage = torch.randn(
+        num_blocks * block_stride_rows, _DIM_QK, dtype=torch.bfloat16, device="cuda"
+    )
+    kv_cache = torch.as_strided(
+        storage,
+        (num_blocks, block_size, _DIM_QK),
+        (block_stride_rows * _DIM_QK, _DIM_QK, 1),
+    )
+    # sm_count의 1/4보다 작은 토큰 수만 split-KV 스크래치를 쓴다. workspace 변형은
+    # 스크래치가 가장 커지는 토큰 수를 골라, 예약 상한이 모자라면 잠긴 workspace에서
+    # 실패하게 한다.
+    num_tokens = 2
+    if use_workspace:
+        head_groups = -(-num_heads // min(_BLOCK_H, num_heads))
+
+        def scratch_numel(n: int) -> int:
+            splits = _choose_num_kv_splits(n, head_groups, topk, sm_count)
+            return n * splits if splits > 1 else 0
+
+        num_tokens = max(range(1, sm_count + 1), key=scratch_numel)
+        assert scratch_numel(num_tokens) > 0
+    blocks = torch.randint(0, num_blocks, (num_tokens, topk), device="cuda")
+    offsets = torch.randint(0, block_size, (num_tokens, topk), device="cuda")
+    topk_indices = (blocks * block_stride_rows + offsets).to(torch.int32)
+    topk_indices[:, topk // 2 :] = -1  # indexer 변환 출력: 유효 항목 뒤 -1
+    valid_counts = torch.full(
+        (num_tokens,), topk // 2, dtype=torch.int32, device="cuda"
+    )
+    q_nope = torch.randn(
+        num_tokens, num_heads, 512, dtype=torch.bfloat16, device="cuda"
+    )
+    q_pe = torch.randn(num_tokens, num_heads, 64, dtype=torch.bfloat16, device="cuda")
+
+    impl = object.__new__(TritonMLASparseImpl)
+    impl.scale = 0.1
+    impl._sm_count = sm_count
+    if use_workspace:
+        _reserve_mid_out_workspace(num_heads, topk, sm_count)
+        lock_workspace()  # 이후 증설 불가: 상한 예약이 실제 요청을 덮어야 한다.
+    out, lse = impl._forward_mqa_kernel(
+        (q_nope, q_pe),
+        kv_cache,
+        topk_indices,
+        valid_counts,
+        layer=None,
+        block_size=block_size,
+        is_decode=True,
+    )
+    assert lse is None
+    assert out.shape == (num_tokens, num_heads, 512) and out.dtype == torch.bfloat16
+
+    q = torch.cat((q_nope, q_pe), dim=-1).float()
+    for t in range(num_tokens):
+        rows = topk_indices[t][topk_indices[t] >= 0].long()
+        keys = storage[rows].float()
+        probs = torch.softmax(q[t] @ keys.T * 0.1, dim=-1)
+        ref = probs @ keys[:, :512]
+        torch.testing.assert_close(out[t].float(), ref, atol=3e-2, rtol=3e-2)
