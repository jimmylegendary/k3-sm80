+++ b/vllm/v1/attention/backends/mla/triton_mla_sparse.py
@@ -0,0 +1,298 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""SM80(A100/A800/RTX30xx)용 순수 Triton sparse MLA 백엔드 (`TRITON_MLA_SPARSE`).
+
+vllm-project/vllm PR #47629 (origin #38476 haosdent)의 split-KV 커널
+(`triton_mla_sparse_kernel.py`)을 K3.1 split 3/6 이후의 KV layout 위에 얹는다.
+PR의 `XPUMLASparse*` 상속 구조는 쓰지 않고 `flashattn_mla_sparse.py`와 같은
+`SparseMLACommon*` 골격으로 다시 썼다: packed hybrid KV row(`flat_kv_row_view`),
+dense-MHA prefill(컨텍스트 <= index_topk, FA2), spec-as-decode, index group 변환을
+공용 베이스가 처리하고, 이 파일은 `_forward_mqa_kernel` 하나만 구현한다.
+
+P1 범위: bf16/fp16 KV 캐시만(FP8 KV·`fp8_ds_mla`는 P3), CUDA graph 미보증
+(`AttentionCGSupport.NEVER`), DCP/PCP 미지원.
+"""
+
+from dataclasses import dataclass
+from typing import Any, ClassVar
+
+import torch
+
+from vllm.config import VllmConfig, get_current_vllm_config_or_none
+from vllm.config.cache import CacheDType
+from vllm.model_executor.layers.attention.sparse_mla_attention import (
+    SparseMLACommonImpl,
+    SparseMLACommonMetadata,
+    SparseMLACommonMetadataBuilder,
+)
+from vllm.platforms import current_platform
+from vllm.platforms.interface import DeviceCapability
+from vllm.v1.attention.backend import (
+    AttentionBackend,
+    AttentionCGSupport,
+    AttentionLayer,
+    MLAAttentionImpl,
+    MultipleOf,
+)
+from vllm.v1.attention.backends.mla.sparse_utils import (
+    align_blocks_to_rows,
+    flat_kv_row_view,
+)
+from vllm.v1.attention.ops.triton_mla_sparse_kernel import (
+    _DIM_QK,
+    max_split_mid_out_numel,
+    triton_mla_sparse_attention,
+)
+from vllm.v1.kv_cache_interface import AttentionSpec
+from vllm.v1.worker.workspace import (
+    current_workspace_manager,
+    is_workspace_manager_initialized,
+)
+
+
+def _reserve_mid_out_workspace(num_heads: int, index_topk: int, sm_count: int) -> None:
+    """split-KV 커널의 partial-output 스크래치 상한을 공용 workspace에 예약한다.
+
+    `triton_mla.py`의 `_reserve_attn_logits_workspace`와 같은 패턴이다. workspace가
+    잠긴(lock) 뒤에는 증설이 불가능하므로, warmup 전에 최악 크기를 미리 잡는다.
+    상한은 커널이 실제로 쓰는 `_choose_num_kv_splits`로 계산한다
+    (`max_split_mid_out_numel`): 토큰 수가 `sm_count / 4`를 넘으면 split 없이
+    single-pass 커널이 돌므로 스크래치가 필요 없다.
+    """
+    if not is_workspace_manager_initialized():
+        return
+    numel = max_split_mid_out_numel(num_heads, index_topk, sm_count)
+    if numel > 0:
+        current_workspace_manager().get_simultaneous(((numel,), torch.float32))
+
+
+def _mid_out_from_workspace(shape: tuple[int, ...]) -> torch.Tensor:
+    (mid_out,) = current_workspace_manager().get_simultaneous((shape, torch.float32))
+    return mid_out
+
+
+class TritonMLASparseBackend(AttentionBackend):
+    # 커널이 출력을 bf16으로 쓴다(`triton_mla_sparse_attention`); fp16 모델은
+    # 출력 dtype이 어긋나므로 선택 단계에서 거부한다.
+    supported_dtypes: ClassVar[list[torch.dtype]] = [torch.bfloat16]
+    supported_kv_cache_dtypes: ClassVar[list[CacheDType]] = [
+        "auto",
+        "float16",
+        "bfloat16",
+    ]
+
+    @staticmethod
+    def get_name() -> str:
+        return "TRITON_MLA_SPARSE"
+
+    @staticmethod
+    def get_supported_kernel_block_sizes(kv_cache_spec=None) -> list[int | MultipleOf]:
+        # DSA indexer 백엔드가 같은 KV cache group에서 block 64를 요구한다
+        # (`DeepseekV32IndexerBackend`). `MultipleOf(64)`로 두면 더 큰 사용자 지정
+        # block도 허용된다. FlashAttnMLASparseBackend와 동일한 규약.
+        return [MultipleOf(64)]
+
+    @classmethod
+    def customize_spec(cls, spec: AttentionSpec) -> AttentionSpec:
+        # 커널은 캐시를 flat row로 읽는다: block 사이가 row 단위로 정렬돼야 한다.
+        return align_blocks_to_rows(spec)
+
+    @staticmethod
+    def get_builder_cls() -> type["TritonMLASparseMetadataBuilder"]:
+        return TritonMLASparseMetadataBuilder
+
+    @staticmethod
+    def get_impl_cls() -> type[MLAAttentionImpl[Any]]:
+        return TritonMLASparseImpl
+
+    @classmethod
+    def get_supported_head_sizes(cls) -> list[int]:
+        return [_DIM_QK]
+
+    @classmethod
+    def is_mla(cls) -> bool:
+        return True
+
+    @classmethod
+    def is_sparse(cls) -> bool:
+        return True
+
+    @classmethod
+    def supports_compute_capability(cls, capability: DeviceCapability) -> bool:
+        # Ampere(SM80/SM86)와 Ada(SM89). Hopper 이상은 기존 sparse 백엔드가 우선.
+        return capability.major == 8
+
+    @classmethod
+    def supports_combination(
+        cls,
+        head_size: int,
+        dtype: torch.dtype,
+        kv_cache_dtype: CacheDType | None,
+        block_size: int | None,
+        use_mla: bool,
+        has_sink: bool,
+        use_sparse: bool,
+        use_mm_prefix: bool,
+        device_capability: DeviceCapability,
+    ) -> str | None:
+        if kv_cache_dtype not in (None, "auto", "float16", "bfloat16"):
+            return (
+                "Triton MLA Sparse supports only FP16/BF16 KV cache "
+                "(pass --kv-cache-dtype bfloat16); FP8 KV (fp8_ds_mla) needs a "
+                "software-dequant kernel that is not implemented yet"
+            )
+
+        vllm_config = get_current_vllm_config_or_none()
+        if vllm_config is not None and vllm_config.model_config is not None:
+            parallel_config = vllm_config.parallel_config
+            if parallel_config.decode_context_parallel_size > 1:
+                return "Triton MLA Sparse does not support DCP"
+            if parallel_config.prefill_context_parallel_size > 1:
+                return "Triton MLA Sparse does not support PCP"
+            hf_text_config = vllm_config.model_config.hf_text_config
+            if not hasattr(hf_text_config, "index_topk"):
+                return "Triton MLA Sparse requires model with index_topk"
+        return None
+
+
+@dataclass
+class TritonMLASparseMetadata(SparseMLACommonMetadata):
+    pass
+
+
+class TritonMLASparseMetadataBuilder(
+    SparseMLACommonMetadataBuilder[TritonMLASparseMetadata]
+):
+    metadata_cls = TritonMLASparseMetadata
+    # P1은 eager 전용이다. split-KV 커널의 Triton autotune이 graph capture 안에서
+    # 돌지 않도록 먼저 warmup을 넣고(P2) 실제 A100에서 검증한 뒤 UNIFORM_BATCH로
+    # 올린다. PR #47629는 GLM-5.2/A800에서 UNIFORM_BATCH를 검증했으나 핀 위의
+    # packed hybrid row + index group 경로에서는 검증되지 않았다.
+    _cudagraph_support: ClassVar[AttentionCGSupport] = AttentionCGSupport.NEVER
+
+    def __init__(
+        self,
+        kv_cache_spec: AttentionSpec,
+        layer_names: list[str],
+        vllm_config: VllmConfig,
+        device: torch.device,
+    ) -> None:
+        super().__init__(kv_cache_spec, layer_names, vllm_config, device)
+        # spec decode의 verification 요청(1 + num_speculative_tokens)을 decode로
+        # 취급한다. 커널은 query 토큰마다 독립 top-k 행을 읽으므로 query 길이에
+        # 제약이 없다.
+        self._init_reorder_batch_threshold(1, supports_spec_as_decode=True)
+        num_heads = self.model_config.get_num_attention_heads(
+            vllm_config.parallel_config
+        )
+        # builder는 메모리 프로파일링 뒤에 만들어지므로 여기서도 예약한다
+        # (Impl.reserve_workspace는 프로파일링 중 KV cache 크기 계산용).
+        _reserve_mid_out_workspace(
+            num_heads, self.topk_tokens, current_platform.num_compute_units()
+        )
+
+
+class TritonMLASparseImpl(SparseMLACommonImpl[TritonMLASparseMetadata]):
+    # 단일 layer group의 top-k 변환은 layer마다 inline으로 한다(FlashAttn sparse와
+    # 동일): side stream 동기화를 피한다.
+    group_conversion_decode_only: ClassVar[bool] = True
+
+    def __init__(
+        self,
+        num_heads: int,
+        head_size: int,
+        scale: float,
+        num_kv_heads: int,
+        alibi_slopes: list[float] | None,
+        sliding_window: int | None,
+        kv_cache_dtype: str,
+        logits_soft_cap: float | None,
+        attn_type: str,
+        kv_sharing_target_layer_name: str | None,
+        topk_indices_buffer: torch.Tensor | None = None,
+        indexer: Any | None = None,
+        **mla_args: Any,
+    ) -> None:
+        unsupported_features = [alibi_slopes, sliding_window, logits_soft_cap]
+        if any(unsupported_features):
+            raise NotImplementedError(
+                "TritonMLASparseImpl does not support alibi, sliding window, "
+                "or logits soft cap."
+            )
+        if kv_cache_dtype not in ("auto", "float16", "bfloat16"):
+            raise NotImplementedError(
+                "TritonMLASparseImpl currently supports only FP16/BF16 KV cache "
+                f"(got {kv_cache_dtype!r}). FP8 KV (fp8_ds_mla) is planned for "
+                "P3; pass --kv-cache-dtype bfloat16."
+            )
+
+        super().__init__(
+            num_heads,
+            head_size,
+            scale,
+            num_kv_heads,
+            alibi_slopes,
+            sliding_window,
+            kv_cache_dtype,
+            logits_soft_cap,
+            attn_type,
+            kv_sharing_target_layer_name,
+            indexer=indexer,
+            topk_indices_buffer=topk_indices_buffer,
+            **mla_args,
+        )
+        assert self.topk_indices_buffer is not None, (
+            "Indexer or topk_indices_buffer required for sparse MLA"
+        )
+        if self.kv_lora_rank + self.qk_rope_head_dim != _DIM_QK:
+            raise NotImplementedError(
+                "TritonMLASparseImpl kernels are specialised for kv_lora_rank=512 "
+                f"and qk_rope_head_dim=64 (head size {_DIM_QK}); got "
+                f"{self.kv_lora_rank}+{self.qk_rope_head_dim}."
+            )
+        self._sm_count = current_platform.num_compute_units()
+
+    def reserve_workspace(self) -> None:
+        # 프로파일링 중에 호출된다: builder보다 먼저 상한을 잡아 KV cache 크기
+        # 계산에 반영한다.
+        assert self.topk_indices_buffer is not None
+        _reserve_mid_out_workspace(
+            self.num_heads, self.topk_indices_buffer.shape[-1], self._sm_count
+        )
+
+    def _forward_mqa_kernel(
+        self,
+        q: torch.Tensor | tuple[torch.Tensor, torch.Tensor],
+        kv_cache: torch.Tensor,
+        topk_indices: torch.Tensor,
+        valid_counts: torch.Tensor,
+        *,
+        layer: AttentionLayer,
+        block_size: int,
+        is_decode: bool,
+    ) -> tuple[torch.Tensor, torch.Tensor | None]:
+        # valid_counts: 유효 항목이 앞쪽으로 압축돼 있지만 커널은 -1(무효) 마스킹으로
+        # 처리한다. 짧은 컨텍스트에서 무효 tile을 건너뛰는 최적화는 P2.
+        if isinstance(q, tuple):
+            # (ql_nope [T, N, 512], q_pe [T, N, 64]) -> [T, N, 576]
+            q = torch.cat(q, dim=-1)
+        if q.stride(-1) != 1:
+            q = q.contiguous()
+
+        # packed hybrid KV row: 한 layer의 캐시가 다른 layer의 page 사이에 놓여
+        # block stride가 block_size보다 크다. flat row view의 row id는
+        # `block * block_stride_rows + offset`이고 커널은 이를 int64로 승격해
+        # `row * 576` 오프셋이 2**31을 넘어도 안전하다.
+        kv_rows, _ = flat_kv_row_view(kv_cache, block_size)
+
+        out = triton_mla_sparse_attention(
+            q,
+            kv_rows.unsqueeze(1),
+            topk_indices.unsqueeze(1),
+            sm_scale=self.scale,
+            sm_count=self._sm_count,
+            mid_out_getter=(
+                _mid_out_from_workspace if is_workspace_manager_initialized() else None
+            ),
+        )
+        return out, None
