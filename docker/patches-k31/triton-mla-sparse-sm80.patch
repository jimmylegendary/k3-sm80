+def _validate(device_capability, **overrides):
+    kwargs = dict(
+        head_size=_DIM_QK,
+        dtype=torch.bfloat16,
+        kv_cache_dtype="bfloat16",
+        block_size=64,
+        use_mla=True,
+        has_sink=False,
+        use_sparse=True,
+        use_mm_prefix=False,
+        use_per_head_quant_scales=False,
+        device_capability=device_capability,
+        attn_type="decoder",
+    )
+    kwargs.update(overrides)
+    return TritonMLASparseBackend.validate_configuration(**kwargs)
+
+
+def test_registry_resolves_the_backend_class():
+    backend = AttentionBackendEnum.TRITON_MLA_SPARSE
+    assert backend.get_class() is TritonMLASparseBackend
+    assert TritonMLASparseBackend.get_name() == "TRITON_MLA_SPARSE"
+    assert AttentionBackendEnum["TRITON_MLA_SPARSE"] is backend
+
+
+def test_classes_follow_the_sparse_mla_common_template():
+    assert issubclass(TritonMLASparseBackend, AttentionBackend)
+    assert issubclass(TritonMLASparseMetadata, SparseMLACommonMetadata)
+    assert issubclass(TritonMLASparseMetadataBuilder, SparseMLACommonMetadataBuilder)
+    assert issubclass(TritonMLASparseImpl, SparseMLACommonImpl)
+    assert TritonMLASparseBackend.get_builder_cls() is TritonMLASparseMetadataBuilder
+    assert TritonMLASparseBackend.get_impl_cls() is TritonMLASparseImpl
+    assert TritonMLASparseMetadataBuilder.metadata_cls is TritonMLASparseMetadata
+    # 유일한 추상 훅이 구현돼 있어야 한다.
+    assert (
+        TritonMLASparseImpl._forward_mqa_kernel
+        is not SparseMLACommonImpl._forward_mqa_kernel
+    )
+
+
+def test_backend_flags_and_block_layout():
+    backend = TritonMLASparseBackend
+    assert backend.is_mla() and backend.is_sparse()
+    assert backend.get_supported_head_sizes() == [576]
+    assert backend.get_supported_kernel_block_sizes() == [MultipleOf(64)]
+    assert backend.supports_block_size(64) and backend.supports_block_size(128)
+    assert not backend.supports_block_size(16)
+    assert not backend.supports_block_size(32)
+    # packed hybrid row: block 사이가 row(576 x 2 B = 1152 B) 단위로 정렬되도록
+    # spec을 맞춘다 (`align_blocks_to_rows`).
+    spec = MLAAttentionSpec(
+        block_size=64, num_kv_heads=1, head_size=_DIM_QK, dtype=torch.bfloat16
+    )
+    assert spec.block_stride_alignment is None
+    assert backend.customize_spec(spec).block_stride_alignment == 576 * 2
+
+
+@pytest.mark.parametrize(
+    "capability,expected",
+    [
+        (SM75, False),
+        (SM80, True),
+        (SM86, True),
+        (SM90, False),
+        (SM100, False),
+        (SM120, False),
+    ],
+    ids=["sm75", "sm80", "sm86", "sm90", "sm100", "sm120"],
+)
+def test_supports_only_ampere_family(capability, expected):
+    assert TritonMLASparseBackend.supports_compute_capability(capability) is expected
+
+
+def test_dtype_filters():
+    assert TritonMLASparseBackend.supported_dtypes == [torch.bfloat16]
+    assert TritonMLASparseBackend.supported_kv_cache_dtypes == [
+        "auto",
+        "float16",
+        "bfloat16",
+    ]
+    for kv in ("auto", "float16", "bfloat16"):
