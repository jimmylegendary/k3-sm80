+    assert "dtype not supported" in _validate(SM80, dtype=torch.float16)
+    assert "head_size not supported" in _validate(SM80, head_size=512)
+    assert "block_size not supported" in _validate(SM80, block_size=16)
+    assert "non-sparse not supported" in _validate(SM80, use_sparse=False)
+    assert "non-MLA not supported" in _validate(SM80, use_mla=False)
+
+
+def test_cuda_priorities_put_the_backend_last_on_sm8x_and_sm9x():
+    try:
+        from vllm.platforms.cuda import _get_backend_priorities
+    except ImportError as e:  # pragma: no cover - 호스트에 따라 다름
+        pytest.skip(f"CUDA platform unavailable on this host: {e}")
