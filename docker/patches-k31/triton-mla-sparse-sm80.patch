+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Correctness tests for the Triton sparse MLA kernel.
+
+Compares split-KV against the single-pass (`num_kv_splits=1`) path
+produced by the same kernel — both paths must agree to within bf16 ULPs.
+"""
+
+import pytest
+import torch
+
+from vllm.platforms import current_platform
+from vllm.v1.attention.ops.triton_mla_sparse_kernel import (
+    _BLOCK_DV,
+    _DIM_QK,
+    triton_mla_sparse_attention,
+)
+
+pytestmark = pytest.mark.skipif(
+    not current_platform.is_cuda_alike(),
+    reason="Triton sparse MLA kernel requires CUDA/ROCm",
+)
+
+
+@pytest.fixture(scope="module")
+def kv_cache():
+    torch.manual_seed(0)
+    return torch.randn(32768, 1, _DIM_QK, dtype=torch.bfloat16, device="cuda")
+
+
+def _assert_split_matches_single_pass(
+    num_tokens: int,
+    num_heads: int,
+    topk: int,
+    num_kv_splits: int | None,
+    kv_cache: torch.Tensor,
+) -> None:
+    torch.manual_seed(0)
+    q = torch.randn(num_tokens, num_heads, _DIM_QK, dtype=torch.bfloat16, device="cuda")
+    indices = torch.randint(
+        0, kv_cache.shape[0], (num_tokens, 1, topk), dtype=torch.int32, device="cuda"
+    )
+    out_ref = triton_mla_sparse_attention(
+        q,
+        kv_cache,
+        indices,
+        sm_scale=0.1,
+        num_kv_splits=1,
+    )
+    out = triton_mla_sparse_attention(
+        q,
+        kv_cache,
+        indices,
+        sm_scale=0.1,
+        num_kv_splits=num_kv_splits,
+    )
+    torch.testing.assert_close(
+        out.float(),
+        out_ref.float(),
+        atol=5e-2,
+        rtol=5e-3,
+    )
+
+
+@pytest.mark.parametrize(
+    "num_tokens,num_heads",
+    [(1, 16), (1, 128), (8, 32), (32, 128), (128, 16)],
+)
+@pytest.mark.parametrize("topk", [1024, 2048, 4096])
+@pytest.mark.parametrize("num_kv_splits", [2, 4, 8])
+def test_split_kv_matches_single_pass(
+    num_tokens, num_heads, topk, num_kv_splits, kv_cache
+):
+    _assert_split_matches_single_pass(
+        num_tokens,
+        num_heads,
+        topk,
+        num_kv_splits,
+        kv_cache,
+    )
+
+
+@pytest.mark.parametrize("num_tokens", [1, 8, 32, 128])
+def test_auto_split_matches_single_pass(num_tokens, kv_cache):
+    _assert_split_matches_single_pass(
+        num_tokens,
+        num_heads=128,
+        topk=2048,
+        num_kv_splits=None,
+        kv_cache=kv_cache,
+    )
+
+
+@pytest.mark.parametrize("num_kv_splits", [1, 2, 4, 8])
+def test_short_prefill_no_nan(num_kv_splits, kv_cache):
+    """Regression: short prefill where most topk slots are -1 sentinels.
+
+    The indexer fills 2048 topk positions with only a handful of valid
+    indices; the rest are -1. Before the NEG_LARGE sentinel fix, the online
+    softmax produced NaN via `max(-inf, -inf) = -inf` and
+    `exp2(-inf − -inf) = NaN`, poisoning every split.
+    """
+    torch.manual_seed(0)
+    num_tokens, num_heads, topk = 5, 16, 2048
+    q = torch.randn(num_tokens, num_heads, _DIM_QK, dtype=torch.bfloat16, device="cuda")
+    indices = torch.full((num_tokens, 1, topk), -1, dtype=torch.int32, device="cuda")
+    # Only the first `t+1` slots of each query hold valid indices; the
+    # remaining ~2045 slots are -1, producing many all-invalid BLOCK_N tiles.
+    for t in range(num_tokens):
+        indices[t, 0, : t + 1] = torch.arange(
+            64, 64 + t + 1, dtype=torch.int32, device="cuda"
+        )
+    out = triton_mla_sparse_attention(
+        q, kv_cache, indices, sm_scale=0.0417, num_kv_splits=num_kv_splits
+    )
+    assert not torch.isnan(out).any()
+    assert not torch.isinf(out).any()
+
+
+# ---------------------------------------------------------------------------
+# K3.1 SM80 rebase 추가분: PR #47629의 테스트는 split-vs-single-pass 일치만
+# 확인하므로 (1) torch 기준 구현과의 일치, (2) K3.1 TP8의 로컬 head 수 12/24,
+# (3) packed hybrid KV row의 큰 row id(row * 576 > 2**31), (4) workspace 스크래치
+# 주입을 따로 검증한다.
+# ---------------------------------------------------------------------------
+
+
+def _reference_sparse_attention(
+    q: torch.Tensor,
+    kv: torch.Tensor,
+    indices: torch.Tensor,
+    sm_scale: float,
+) -> torch.Tensor:
+    """선택된 row 위에서만 softmax하는 dense torch 기준 구현 (fp32)."""
+    kv_rows = kv[:, 0]
+    idx = indices[:, 0].long()
+    valid = (idx >= 0) & (idx < kv_rows.shape[0])
+    gathered = kv_rows[idx.clamp(min=0)].float()
+    scores = torch.einsum("thd,tkd->thk", q.float(), gathered) * sm_scale
+    scores = scores.masked_fill(~valid[:, None, :], float("-inf"))
+    probs = torch.nan_to_num(torch.softmax(scores, dim=-1))
+    return torch.einsum("thk,tkd->thd", probs, gathered[..., :_BLOCK_DV])
+
+
+@pytest.mark.parametrize(
+    "num_tokens,num_heads,num_kv_splits",
+    [
+        (1, 12, 1),  # K3.1 TP8: 96 heads / 8
+        (1, 12, 4),
+        (5, 12, 1),
+        (3, 24, 2),  # K3.1 TP4: 두 번째 head group이 부분 마스크
+        (2, 16, None),
+    ],
+)
+@pytest.mark.parametrize("topk", [256, 2048])
+def test_matches_torch_reference(num_tokens, num_heads, num_kv_splits, topk, kv_cache):
+    torch.manual_seed(1)
+    q = torch.randn(num_tokens, num_heads, _DIM_QK, dtype=torch.bfloat16, device="cuda")
+    indices = torch.randint(
+        0, kv_cache.shape[0], (num_tokens, 1, topk), dtype=torch.int32, device="cuda"
+    )
+    # 앞쪽으로 압축된 유효 항목 + 뒤쪽 -1 (indexer 변환 출력과 같은 모양)
+    indices[:, :, topk // 2 :] = -1
+    out = triton_mla_sparse_attention(
+        q, kv_cache, indices, sm_scale=0.1, num_kv_splits=num_kv_splits
+    )
+    ref = _reference_sparse_attention(q, kv_cache, indices, 0.1)
+    torch.testing.assert_close(out.float(), ref, atol=3e-2, rtol=3e-2)
+
+
+def test_all_invalid_indices_give_zero_output(kv_cache):
+    q = torch.randn(2, 12, _DIM_QK, dtype=torch.bfloat16, device="cuda")
+    indices = torch.full((2, 1, 2048), -1, dtype=torch.int32, device="cuda")
+    for num_kv_splits in (1, 4):
+        out = triton_mla_sparse_attention(
+            q, kv_cache, indices, sm_scale=0.1, num_kv_splits=num_kv_splits
+        )
+        assert torch.count_nonzero(out) == 0
+
+
+def test_row_ids_beyond_int32_offset():
+    """Packed hybrid KV row에서는 `row * 576`이 ~139k 토큰부터 2**31을 넘는다.
+
+    row id 자체는 int32 범위지만 element 오프셋(row * stride_kv_token)이 int32로
+    계산되면 wrap되어 잘못된 주소를 읽거나(IMA) 조용히 틀린 값을 낸다.
+    """
+    int32_row_limit = 2**31 // _DIM_QK  # 3,728,270
+    num_rows = int32_row_limit + 40_000
+    needed = num_rows * _DIM_QK * 2
+    free, _ = torch.cuda.mem_get_info()
+    if free < needed + 2 * 2**30:
+        pytest.skip(f"needs {needed / 2**30:.1f} GiB of free GPU memory")
+
+    torch.manual_seed(2)
+    kv = torch.zeros(num_rows, 1, _DIM_QK, dtype=torch.bfloat16, device="cuda")
+    tail = 8192
+    kv[-tail:] = torch.randn(tail, 1, _DIM_QK, dtype=torch.bfloat16, device="cuda")
+    num_tokens, num_heads, topk = 2, 12, 2048
+    q = torch.randn(num_tokens, num_heads, _DIM_QK, dtype=torch.bfloat16, device="cuda")
+    # 모든 유효 row를 int32 오프셋 한계 뒤에 둔다.
+    rows = (
+        num_rows - tail + torch.randint(0, tail, (num_tokens, 1, topk), device="cuda")
+    )
+    indices = rows.to(torch.int32)
+    indices[:, :, -64:] = -1
+    assert int(indices.max()) * _DIM_QK > 2**31
+    for num_kv_splits in (1, 4):
+        out = triton_mla_sparse_attention(
+            q, kv, indices, sm_scale=0.1, num_kv_splits=num_kv_splits
+        )
+        ref = _reference_sparse_attention(q, kv, indices, 0.1)
+        torch.testing.assert_close(out.float(), ref, atol=3e-2, rtol=3e-2)
+
+
+def test_mid_out_getter_matches_default(kv_cache):
+    torch.manual_seed(3)
+    num_tokens, num_heads, topk, splits = 3, 12, 2048, 4
+    q = torch.randn(num_tokens, num_heads, _DIM_QK, dtype=torch.bfloat16, device="cuda")
+    indices = torch.randint(
+        0, kv_cache.shape[0], (num_tokens, 1, topk), dtype=torch.int32, device="cuda"
+    )
+    default = triton_mla_sparse_attention(
+        q, kv_cache, indices, sm_scale=0.1, num_kv_splits=splits
+    )
+
+    shapes: list[tuple[int, ...]] = []
+    scratch = torch.full((2**22,), float("nan"), dtype=torch.float32, device="cuda")
+
+    def getter(shape: tuple[int, ...]) -> torch.Tensor:
+        shapes.append(shape)
+        numel = 1
+        for dim in shape:
+            numel *= dim
+        return scratch[:numel].view(shape)
+
+    injected = triton_mla_sparse_attention(
+        q,
+        kv_cache,
+        indices,
+        sm_scale=0.1,
+        num_kv_splits=splits,
+        mid_out_getter=getter,
+    )
+    assert shapes == [(num_tokens, num_heads, splits, _BLOCK_DV + 1)]
+    torch.testing.assert_close(injected, default, atol=0, rtol=0)
+    # single-pass 경로는 스크래치를 요청하지 않는다.
+    shapes.clear()
+    triton_mla_sparse_attention(
+        q, kv_cache, indices, sm_scale=0.1, num_kv_splits=1, mid_out_getter=getter
+    )
+    assert shapes == []
