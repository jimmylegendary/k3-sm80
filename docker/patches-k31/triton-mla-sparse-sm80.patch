+"""`TRITON_MLA_SPARSE`(SM80 Triton sparse MLA) 백엔드의 선택·계약 테스트.
+
+대부분 GPU 없이 도는 테스트다: 클래스 상속, capability/dtype/KV dtype 필터, CUDA
+후보 우선순위와 SM80 자동 선택, split-KV workspace 상한이 커널이 실제로 요청하는
+크기를 모두 덮는지를 확인한다. CUDA가 있으면 `_forward_mqa_kernel`을 packed KV
+row 캐시로 통합 검증한다(잠긴 workspace 포함). 커널 수치 자체는
+`tests/kernels/attention/test_triton_mla_sparse_kernel.py`가 본다.
+
+실행(vLLM 테스트 의존성 없이): `python -m pytest --noconftest -p no:cacheprovider \
+tests/v1/attention/test_triton_mla_sparse_backend.py`.
+"""
+
+import pytest
+import torch
+
+from vllm.model_executor.layers.attention.sparse_mla_attention import (
+    SparseMLACommonImpl,
+    SparseMLACommonMetadata,
+    SparseMLACommonMetadataBuilder,
+)
+from vllm.platforms import current_platform
+from vllm.platforms.interface import DeviceCapability
