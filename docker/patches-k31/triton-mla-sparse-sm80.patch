+def test_sm80_auto_selection_lands_on_triton_mla_sparse():
+    try:
+        from vllm.platforms.cuda import CudaPlatform
+    except ImportError as e:  # pragma: no cover - 호스트에 따라 다름
+        pytest.skip(f"CUDA platform unavailable on this host: {e}")
+
+    config = AttentionSelectorConfig(
+        head_size=_DIM_QK,
+        dtype=torch.bfloat16,
+        kv_cache_dtype="bfloat16",
